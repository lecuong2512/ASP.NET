@model IEnumerable<Day_2_Le_Viet_Cuong.Models.CourseItem>

@{
    ViewData["Title"] = "Danh sach san pham";
}

<h2>Danh sach san pham (Attribute Routing)</h2>
<p>Controller su dung: <code>[Route("san-pham")]</code></p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Ma SP</th>
            <th>Ten san pham</th>
            <th>Giang vien</th>
            <th>Trang thai</th>
            <th>Hanh dong</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>@item.Instructor</td>
                <td>@item.Status</td>
                <td><a href="/san-pham/chi-tiet/@item.Id">Chi tiet</a></td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_StudentCardPartial")
